{
  "manifest_version": 3,
  "name": "Topic Skipper",
  "version": "0.2.0",
  "description": "Skip to the next joke, story or topic instead of 10 seconds at a time.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "src/background.js" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/segment.js", "src/llm.js", "src/transcript.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
